generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              String         @id @default(uuid())
  name            String
  description     String
  date            DateTime
  location        String
  maxParticipants Int            @map("max_participants")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime?      @updatedAt @map("updated_at")
  registrations   Registration[]

  @@map("events")
}

model Registration {
  id             String   @id @default(uuid())
  name           String
  cpf            String
  phone          String
  email          String
  extraLunch     Boolean  @default(false) @map("extra_lunch")
  eventId        String   @map("event_id")
  regionalId     String   @map("regional_id")
  congregationId String   @map("congregation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  event        Event        @relation(fields: [eventId], references: [id])
  regional     Regional     @relation(fields: [regionalId], references: [id])
  congregation Congregation @relation(fields: [congregationId], references: [id])

  @@unique([cpf, eventId])
  @@map("registrations")
}

model Regional {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  congregations Congregation[]
  registrations Registration[]

  @@map("regionals")
}

model Congregation {
  id            String         @id @default(uuid())
  name          String
  regionalId    String         @map("regional_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  regional      Regional       @relation(fields: [regionalId], references: [id])
  registrations Registration[]

  @@map("congregations")
}
